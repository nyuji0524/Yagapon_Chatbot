[Unit]
Description=YagaPon Discord Bot containers
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/yagapon
Environment=YAGAPON_ENV_FILE=/etc/yagapon/yagapon.env
Environment=YAGAPON_DATA_PATH=/var/lib/yagapon
Environment=YAGAPON_BIND_ADDRESS=0.0.0.0
Environment=YAGAPON_HOST_PORT=8000
ExecStart=/usr/bin/docker compose up --remove-orphans
ExecStop=/usr/bin/docker compose down
Restart=always
RestartSec=10
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
