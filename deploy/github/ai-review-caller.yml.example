name: YagaPon AI Review

on:
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]

permissions:
  contents: read
  pull-requests: write

jobs:
  review:
    uses: nyuji0524/Yagapon_Chatbot/.github/workflows/ai-review.yml@main
    secrets:
      GOOGLE_API_KEY: ${{ secrets.GOOGLE_API_KEY }}
