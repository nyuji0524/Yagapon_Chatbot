GOOGLE_API_KEY=
YAGAPON_RAG_MODEL=gemini-3.8-flash
YAGAPON_RESPONSE_MODEL=gemini-3.8-flash
YAGAPON_FAST_MODEL=gemini-3.1-flash-lite
YAGAPON_TRANSCRIBE_MODEL=gemini-3.5-transcribe
YAGAPON_TRANSCRIBE_FALLBACK_MODEL=gemini-3.8-flash
YAGAPON_AUDIO_MODEL=gemini-3.8-flash
YAGAPON_DAILY_QUERY_LIMIT=400
# 同時に履歴取得するDiscordチャンネル数。1〜8、既定3。File Searchアップロード自体は別途最大5並列。
YAGAPON_BACKFILL_CONCURRENCY=3
YAGAPON_RAG_DB_PATH=/data/rag.sqlite3
YAGAPON_KEY_DB_PATH=/data/key-management.sqlite3
YAGAPON_KEY_REMINDER_HOURS=8
YAGAPON_KEY_REMINDER_REPEAT_HOURS=12
YAGAPON_KEY_NOTIFICATION_TTL_SECONDS=300
# disabled（既定）/ emulator（ローカル）/ firestore（本番）を明示指定する
YAGAPON_SUPPORT_BACKEND=disabled
YAGAPON_SUPPORT_FIREBASE_PROJECT=demo-yagapon-support
YAGAPON_SUPPORT_FIRESTORE_EMULATOR_HOST=support-firestore:8080
# true の場合のみ、管理者承認済み利用者へ「矢上祭実行委員」を追記する
YAGAPON_SUPPORT_ROLE_SYNC_ENABLED=false
YAGAPON_SUPPORT_LOOKUP_TIMEOUT_SECONDS=8
YAGAPON_RAG_TRACE_CONTENT=false
# Full backfill後にtrueへ切り替える（旧文書にはfestivalメタデータがないため）
YAGAPON_RAG_FESTIVAL_FILTER_ENABLED=false
DISCORD_TOKEN=
YAGAPON_API_TOKEN=
API_HOST=https://your-server.example.com
API_PORT=8000
GOOGLE_SERVICE_ACCOUNT_JSON=
# OAuth authorized-user JSONの本文またはコンテナ内パス。設定時はサービスアカウント/ADCより優先。
GOOGLE_OAUTH_AUTHORIZED_USER_JSON=
YAGAPON_CONFIG_PATH=/data/server_config.json
YAGAPON_CATALOG_PATH=/data/knowledge-catalog.json
YAGAPON_CATALOG_MODEL=gemini-3.1-flash-lite
YAGAPON_CATALOG_PASSES=2
YAGAPON_VOICEPRINT_DIR=/data/voiceprints
YAGAPON_RECORDING_DIR=/data/recordings
YAGAPON_TRANSCRIPT_DIR=/data/transcripts
YAGAPON_OPERATIONS_DB_PATH=/data/operations.sqlite3
YAGAPON_RECORDING_RECOVERY_BATCH_SIZE=3
YAGAPON_RECORDING_RECOVERY_MAX_ATTEMPTS=8
YAGAPON_RECORDING_RECOVERY_INTERVAL_SECONDS=300
YAGAPON_KNOWLEDGE_OUTBOX=/data/knowledge-outbox
YAGAPON_KNOWLEDGE_REPOSITORY=YagamiFes-IT/YagamiFes-IT-Knowledge
YAGAPON_KNOWLEDGE_BASE_BRANCH=main
# GCSキューへ送り、Knowledge側GitHub Actionsの短命なGITHUB_TOKENでDraft PR化する。
YAGAPON_KNOWLEDGE_GCS_BUCKET=
# falseにするとAI議事録をDraft PRへ含めず、生文字起こしと要約だけにする。
YAGAPON_KNOWLEDGE_INCLUDE_MINUTES=true
# File Searchの生ログ・コード・既存Knowledgeを議題別Draftへ継続整理する。Actions側のPR作成許可後だけtrueにする。
YAGAPON_KNOWLEDGE_CURATION_ENABLED=false
YAGAPON_KNOWLEDGE_CURATION_BATCH=3
YAGAPON_KNOWLEDGE_CURATION_STATE=/data/knowledge-curation.sqlite3
YAGAPON_KNOWLEDGE_PIPELINE_LOCK=/data/knowledge-pipeline.lock
YAGAPON_KNOWLEDGE_CURATION_CHANNEL_IDS=
YAGAPON_KNOWLEDGE_CURATION_MODEL_CALLS_PER_RUN=6
YAGAPON_KNOWLEDGE_CURATION_GENERATIONS_PER_RUN=3
YAGAPON_KNOWLEDGE_CURATION_MAX_OPEN_BUNDLES=5
YAGAPON_KNOWLEDGE_CURATION_INTERVAL_SECONDS=21600
YAGAPON_KNOWLEDGE_CURATION_RETRY_SECONDS=900
YAGAPON_KNOWLEDGE_BACKFILL_STATE=
YAGAPON_KNOWLEDGE_BACKFILL_MAX_AGE_SECONDS=28800
# Discord原文を6時間ごとに差分取得する。guild/channelはimmutable IDで明示する。
YAGAPON_SCHEDULED_BACKFILL_ENABLED=false
YAGAPON_SCHEDULED_BACKFILL_GUILD_IDS=
# 必須。Text/Forum親/明示的なprivate threadのimmutable ID
YAGAPON_SCHEDULED_BACKFILL_CHANNEL_IDS=
YAGAPON_SCHEDULED_BACKFILL_INTERVAL_SECONDS=21600
YAGAPON_SCHEDULED_BACKFILL_RETRY_SECONDS=900
YAGAPON_SCHEDULED_BACKFILL_INITIAL_DELAY_SECONDS=300
# 録音1セッションの上限(4 GiB)。さらにディスク空き容量から下記予備分を除いた範囲に自動制限される。
YAGAPON_MAX_RECORDING_BYTES=4294967296
YAGAPON_RECORDING_FREE_SPACE_RESERVE_BYTES=2147483648
# 音声は正常配信後に即時削除。ここでは配信メタデータの保持日数を指定する。
# 失敗・不完全な録音は文字起こし復旧用に自動削除しない。
YAGAPON_RECORDING_RETENTION_DAYS=7
GOOGLE_DRIVE_ID=
GOOGLE_DRIVE_FOLDER_ID=
YAGAPON_DRIVE_SYNC_STATE=/data/drive-sync-state.json
YAGAPON_DRIVE_RECURSIVE=true
YAGAPON_KNOWLEDGE_OUTPUT=/data/knowledge-drafts
YAGAPON_KNOWLEDGE_MODEL=gemini-3.8-flash
YAGAPON_KNOWLEDGE_REPO_PATH=../YagamiFes-IT-Knowledge
YAGAPON_KNOWLEDGE_BASE_URL=https://github.com/YagamiFes-IT/YagamiFes-IT-Knowledge/blob/main
YAGAPON_KNOWLEDGE_GUILD_ID=
# Knowledge登録コマンドを許可するGuild。空の場合は上記Guildだけを使う。複数はカンマ区切り。
YAGAPON_KNOWLEDGE_ALLOWED_GUILD_IDS=
# 限定会議を共有Drive・Knowledgeへ外部化してよいchannel/category ID。複数はカンマ区切り。
YAGAPON_MEETING_EXPORT_CHANNEL_IDS=
# 選考などKnowledgeへ載せない機微チャンネル。IDと名前の部分一致語をカンマ区切りで指定する。
YAGAPON_KNOWLEDGE_DENY_CHANNEL_IDS=
YAGAPON_KNOWLEDGE_DENY_CHANNEL_TERMS=選考
YAGAPON_KNOWLEDGE_INDEX_STATE=/data/knowledge-index-state.json
YAGAPON_KNOWLEDGE_INDEX_STATUSES=active,historical
YAGAPON_SOURCE_INDEX_ENABLED=false
# Production normally sets the IDs in deploy.env and bind-mounts only the PEM
# into source-index-watch. The ID values also support *_FILE when desired.
YAGAPON_SOURCE_GITHUB_APP_ID=
YAGAPON_SOURCE_GITHUB_APP_ID_FILE=
YAGAPON_SOURCE_GITHUB_APP_INSTALLATION_ID=
YAGAPON_SOURCE_GITHUB_APP_INSTALLATION_ID_FILE=
YAGAPON_SOURCE_GITHUB_APP_PRIVATE_KEY=
# Compose fixes the container path below; the host file stays outside /data.
YAGAPON_SOURCE_GITHUB_APP_PRIVATE_KEY_HOST_FILE=
YAGAPON_SOURCE_GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app-private-key.pem
# Compatibility fallback only; prefer the read-only GitHub App above.
YAGAPON_SOURCE_GITHUB_TOKEN=
YAGAPON_SOURCE_GITHUB_TOKEN_FILE=
# Empty means every entry in source_index/repositories.yaml, never every
# repository visible to the organization-wide GitHub App installation.
YAGAPON_SOURCE_REPOSITORIES=
YAGAPON_SOURCE_HISTORY_SINCE=2024-10-01T00:00:00+09:00
YAGAPON_SOURCE_HISTORY_UNTIL=
YAGAPON_SOURCE_HISTORY_COMMITS_PER_CYCLE=100
YAGAPON_SOURCE_HISTORY_MAX_COMMITS=2000
YAGAPON_SOURCE_HISTORY_MAX_PAGES=20
YAGAPON_SOURCE_HISTORY_MAX_FILES_PER_COMMIT=300
YAGAPON_SOURCE_HISTORY_MAX_BYTES_PER_REPOSITORY=20000000
YAGAPON_SOURCE_HISTORY_MIN_RATE_REMAINING=200
YAGAPON_SOURCE_HISTORY_MAX_FILE_SNAPSHOTS_PER_REPOSITORY=10
