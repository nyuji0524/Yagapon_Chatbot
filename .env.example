GOOGLE_API_KEY=
YAGAPON_RAG_MODEL=gemini-3.5-flash-lite
YAGAPON_RESPONSE_MODEL=gemini-3.5-flash-lite
# 長文議事録だけは品質優先。通常応答とは独立して切り替え可能。
YAGAPON_MINUTES_MODEL=gemini-3.8-flash
YAGAPON_FAST_MODEL=gemini-3.1-flash-lite
YAGAPON_TRANSCRIBE_MODEL=gemini-3.5-transcribe
YAGAPON_TRANSCRIBE_FALLBACK_MODEL=gemini-3.5-flash-lite
YAGAPON_AUDIO_MODEL=gemini-3.5-flash-lite
YAGAPON_DAILY_QUERY_LIMIT=400
# 同時に履歴取得するDiscordチャンネル数。1〜8、既定3。File Searchアップロード自体は別途最大5並列。
YAGAPON_BACKFILL_CONCURRENCY=3
# 非冪等なFile Search upload開始の総待ち時間。30〜900秒、既定180秒。
YAGAPON_FILE_SEARCH_UPLOAD_START_TIMEOUT_SECONDS=180
# File Searchが受理した1文書の索引完了待ち。300〜7200秒、既定1800秒。
YAGAPON_FILE_SEARCH_INDEX_TIMEOUT_SECONDS=1800
YAGAPON_RAG_DB_PATH=/data/rag.sqlite3
YAGAPON_PREFLIGHT_FULL_SQLITE_CHECK=false
YAGAPON_KEY_DB_PATH=/data/key-management.sqlite3
YAGAPON_KEY_REMINDER_HOURS=8
YAGAPON_KEY_REMINDER_REPEAT_HOURS=12
YAGAPON_KEY_NOTIFICATION_TTL_SECONDS=300
# disabled（既定）/ emulator（ローカル）/ firestore（本番）を明示指定する
YAGAPON_SUPPORT_BACKEND=disabled
YAGAPON_SUPPORT_FIREBASE_PROJECT=demo-yagapon-support
YAGAPON_SUPPORT_FIRESTORE_EMULATOR_HOST=support-firestore:8080
# true の場合のみ、管理者承認済み利用者へ「矢上祭実行委員」を追記する
YAGAPON_SUPPORT_ROLE_SYNC_ENABLED=false
YAGAPON_SUPPORT_LOOKUP_TIMEOUT_SECONDS=8
# Firebase current-value retrieval. Credentials may read broadly, but only the
# reviewed collection/field projection in bot/firebase_knowledge.py is exposed.
YAGAPON_FIREBASE_KNOWLEDGE_ENABLED=false
YAGAPON_FIREBASE_KNOWLEDGE_BACKEND=public
YAGAPON_FIREBASE_KNOWLEDGE_PROJECT=
YAGAPON_FIREBASE_KNOWLEDGE_API_KEY=
YAGAPON_FIREBASE_KNOWLEDGE_EMULATOR_HOST=support-firestore:8080
YAGAPON_FIREBASE_KNOWLEDGE_TIMEOUT_SECONDS=8
YAGAPON_FIREBASE_KNOWLEDGE_CACHE_SECONDS=60
YAGAPON_FIREBASE_KNOWLEDGE_LIMIT=100
YAGAPON_FIREBASE_KNOWLEDGE_MAX_DOCUMENTS=2000
YAGAPON_RAG_TRACE_CONTENT=false
# true（既定）では回答状態と使用したexact/runtime evidence keyの明示を必須にする。
YAGAPON_RAG_REQUIRE_ANSWER_STATUS=true
# true（既定）ではFile Searchの回答区間と根拠chunkの対応が欠けた回答を棄却する。
YAGAPON_RAG_REQUIRE_GROUNDING_SUPPORTS=true
# 認可済みgrounding segmentが回答本文を覆う最小比率。重要な数値・権限・状態の主張は常に完全一致を要求する。
YAGAPON_RAG_GROUNDING_COVERAGE_THRESHOLD=0.8
# Full backfill後にtrueへ切り替える（旧文書にはfestivalメタデータがないため）
YAGAPON_RAG_FESTIVAL_FILTER_ENABLED=false
DISCORD_TOKEN=
YAGAPON_API_TOKEN=
API_HOST=https://your-server.example.com
API_PORT=8000
GOOGLE_SERVICE_ACCOUNT_JSON=
# OAuth authorized-user JSONの本文またはコンテナ内パス。設定時はサービスアカウント/ADCより優先。
GOOGLE_OAUTH_AUTHORIZED_USER_JSON=
YAGAPON_CONFIG_PATH=/data/server_config.json
YAGAPON_CATALOG_PATH=/data/knowledge-catalog.json
YAGAPON_CATALOG_MODEL=gemini-3.1-flash-lite
YAGAPON_CATALOG_PASSES=2
YAGAPON_VOICEPRINT_DIR=/data/voiceprints
YAGAPON_RECORDING_DIR=/data/recordings
YAGAPON_TRANSCRIPT_DIR=/data/transcripts
YAGAPON_OPERATIONS_DB_PATH=/data/operations.sqlite3
YAGAPON_RECORDING_RECOVERY_BATCH_SIZE=3
YAGAPON_RECORDING_RECOVERY_MAX_ATTEMPTS=8
YAGAPON_RECORDING_RECOVERY_INTERVAL_SECONDS=300
# 完了済み長時間録音のtimeline/PCM読込上限。I/O waiterを途中放棄しないよう十分長くする。
YAGAPON_FINAL_REPROCESS_IO_TIMEOUT_SECONDS=120
YAGAPON_KNOWLEDGE_OUTBOX=/data/knowledge-outbox
YAGAPON_KNOWLEDGE_REPOSITORY=YagamiFes-IT/YagamiFes-IT-Knowledge
YAGAPON_KNOWLEDGE_BASE_BRANCH=main
# GCSキューへ送り、Knowledge側GitHub Actionsの短命なGITHUB_TOKENでDraft PR化する。
YAGAPON_KNOWLEDGE_GCS_BUCKET=
YAGAPON_KNOWLEDGE_INTAKE_DISPATCH_ENABLED=true
YAGAPON_KNOWLEDGE_INTAKE_WORKFLOW=yagapon-intake.yml
# Production sets the IDs and Secret Manager host path in deploy.env. The PEM
# belongs to a dedicated actions:write App; never reuse the source-reader App.
YAGAPON_KNOWLEDGE_GITHUB_APP_ID=
YAGAPON_KNOWLEDGE_GITHUB_APP_ID_FILE=
YAGAPON_KNOWLEDGE_GITHUB_APP_INSTALLATION_ID=
YAGAPON_KNOWLEDGE_GITHUB_APP_INSTALLATION_ID_FILE=
YAGAPON_KNOWLEDGE_GITHUB_APP_PRIVATE_KEY=
YAGAPON_KNOWLEDGE_GITHUB_APP_PRIVATE_KEY_HOST_FILE=
YAGAPON_KNOWLEDGE_GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/knowledge-github-app-private-key.pem
# falseにするとAI議事録をDraft PRへ含めず、生文字起こしと要約だけにする。
YAGAPON_KNOWLEDGE_INCLUDE_MINUTES=true
# File Searchの生ログ・コード・既存Knowledgeを議題別Draftへ継続整理する。Actions側のPR作成許可後だけtrueにする。
YAGAPON_KNOWLEDGE_CURATION_ENABLED=false
YAGAPON_KNOWLEDGE_CURATION_BATCH=3
YAGAPON_KNOWLEDGE_CURATION_STATE=/data/knowledge-curation.sqlite3
YAGAPON_KNOWLEDGE_PIPELINE_LOCK=/data/knowledge-pipeline.lock
# Optional comma-separated positive Discord channel IDs; malformed values stop curation.
YAGAPON_KNOWLEDGE_CURATION_CHANNEL_IDS=
YAGAPON_KNOWLEDGE_CURATION_MODEL_CALLS_PER_RUN=6
YAGAPON_KNOWLEDGE_CURATION_MODEL=gemini-3.5-flash-lite
# Non-urgent curation uses Gemini Batch API (50% of standard token pricing).
YAGAPON_KNOWLEDGE_CURATION_USE_BATCH_API=true
YAGAPON_KNOWLEDGE_CURATION_GENERATIONS_PER_RUN=3
YAGAPON_KNOWLEDGE_CURATION_MAX_OPEN_BUNDLES=5
YAGAPON_KNOWLEDGE_CURATION_INTERVAL_SECONDS=21600
YAGAPON_KNOWLEDGE_CURATION_RETRY_SECONDS=900
# scheduler有効時・全期間候補化時は、下のproducer stateと同じ解決先が必須。
YAGAPON_KNOWLEDGE_BACKFILL_STATE=/data/scheduled-backfill-state.json
YAGAPON_KNOWLEDGE_BACKFILL_MAX_AGE_SECONDS=28800
# Discord原文を6時間ごとに差分取得する。Guildは正の10進immutable IDで必須。
YAGAPON_SCHEDULED_BACKFILL_ENABLED=false
YAGAPON_SCHEDULED_BACKFILL_GUILD_IDS=
# 任意の絞り込み。空なら/ignore・denyを除く全TextChannel/public threadを取得する。
YAGAPON_SCHEDULED_BACKFILL_CHANNEL_IDS=
YAGAPON_SCHEDULED_BACKFILL_STATE=/data/scheduled-backfill-state.json
YAGAPON_SCHEDULED_BACKFILL_INTERVAL_SECONDS=21600
YAGAPON_SCHEDULED_BACKFILL_RETRY_SECONDS=900
YAGAPON_SCHEDULED_BACKFILL_INITIAL_DELAY_SECONDS=300
# 録音1セッションの任意上限。0は上限なし（下記の空き容量予備分までは保存を継続）。
YAGAPON_MAX_RECORDING_BYTES=0
YAGAPON_RECORDING_FREE_SPACE_RESERVE_BYTES=2147483648
# 接続前に確保できなければ録音開始自体を拒否する最小headroom（64 MiB）。
YAGAPON_MIN_RECORDING_HEADROOM_BYTES=67108864
# 15分以上の録音で、受信PCMが会議時間の15%未満なら欠落疑いとして警告し、元音声を保持する。
YAGAPON_CAPTURE_HEALTH_MIN_WALL_SECONDS=900
YAGAPON_CAPTURE_HEALTH_MIN_AUDIO_RATIO=0.15
# 接続表示が正常でも、この秒数以上PCMが増えなければVC内蔵chatへ警告する。
# 実際の無言も含む運用警告。終了まで受信再開を確認できない場合は自動公開を止める。
YAGAPON_CAPTURE_HEALTH_MAX_SILENCE_SECONDS=300
# 無音→受信再開→再度無音の通知を抑制する最小間隔。
YAGAPON_CAPTURE_ALERT_COOLDOWN_SECONDS=300
# 録音警告のDiscord送信待ち上限。通知障害で録音再開・fsyncを遅らせない。
YAGAPON_CAPTURE_NOTICE_TIMEOUT_SECONDS=5
# PCMと受信timelineをディスクへ定期fsyncする間隔と、1回の待ち上限。
YAGAPON_CAPTURE_DURABILITY_INTERVAL_SECONDS=10
YAGAPON_CAPTURE_DURABILITY_TIMEOUT_SECONDS=10
# Pycordの受信停止が固着しても、元PCMのflush/closeへ必ず進むための上限。
YAGAPON_STOP_RECORDING_TIMEOUT_SECONDS=10
# Discord音声接続の一時的な再接続を待つ猶予。超過後は不完全公開を防いで録音を保持する。
YAGAPON_CAPTURE_DISCONNECT_GRACE_SECONDS=20
# signal受信からprocess終了までのhard deadline。Composeのstop_grace_period(90秒)より十分短くする。
YAGAPON_SHUTDOWN_DEADLINE_SECONDS=60
# API/Uvicornは先に短く打ち切り、voice fsyncと残りのdurable cleanupへ時間を残す。
YAGAPON_API_SHUTDOWN_TIMEOUT_SECONDS=5
YAGAPON_UVICORN_GRACEFUL_TIMEOUT_SECONDS=10
# 上記のうち、全VCを並列に停止・fsyncするための最大予算。
YAGAPON_VOICE_SHUTDOWN_TIMEOUT_SECONDS=40
# /leaveの最終処理とshutdownが重なった場合に、通常終了を待つ上限。
YAGAPON_SHUTDOWN_ACTIVE_STOP_WAIT_SECONDS=30
# corpus flush単体の上限。shutdown全体の残り時間がこれより短ければ残り時間を優先する。
YAGAPON_CORPUS_SHUTDOWN_TIMEOUT_SECONDS=20
# /leaveが最終文字起こしを待つ上限。超過時はPCMを保持し、常駐復旧処理へ引き継ぐ。
YAGAPON_FINAL_REPROCESS_INTERACTIVE_TIMEOUT_SECONDS=600
# PCM・受信timeline・録音metadataは成否を問わず自動削除しない。
# 容量監視と、確認後の明示削除は運用者が行う。
GOOGLE_DRIVE_ID=
GOOGLE_DRIVE_FOLDER_ID=
YAGAPON_DRIVE_SYNC_STATE=/data/drive-sync-state.json
YAGAPON_DRIVE_RECURSIVE=true
YAGAPON_KNOWLEDGE_OUTPUT=/data/knowledge-drafts
YAGAPON_KNOWLEDGE_MODEL=gemini-3.8-flash
YAGAPON_KNOWLEDGE_REPO_PATH=../YagamiFes-IT-Knowledge
YAGAPON_KNOWLEDGE_BASE_URL=https://github.com/YagamiFes-IT/YagamiFes-IT-Knowledge/blob/main
YAGAPON_KNOWLEDGE_GUILD_ID=
# Knowledge登録コマンドを許可するGuild。空の場合は上記Guildだけを使う。複数はカンマ区切り。
YAGAPON_KNOWLEDGE_ALLOWED_GUILD_IDS=
# 限定会議を共有Drive・Knowledgeへ外部化してよいchannel/category ID。複数はカンマ区切り。
YAGAPON_MEETING_EXPORT_CHANNEL_IDS=
# 選考などKnowledgeへ載せない機微チャンネル。IDと名前の部分一致語をカンマ区切りで指定する。
YAGAPON_KNOWLEDGE_DENY_CHANNEL_IDS=
YAGAPON_KNOWLEDGE_DENY_CHANNEL_TERMS=選考
YAGAPON_KNOWLEDGE_INDEX_STATE=/data/knowledge-index-state.json
YAGAPON_KNOWLEDGE_INDEX_STATUSES=active,historical
YAGAPON_SOURCE_INDEX_ENABLED=false
YAGAPON_SOURCE_PREFLIGHT_REMOTE=false
# Production normally sets the IDs in deploy.env and bind-mounts only the PEM
# into source-index-watch. The ID values also support *_FILE when desired.
YAGAPON_SOURCE_GITHUB_APP_ID=
YAGAPON_SOURCE_GITHUB_APP_ID_FILE=
YAGAPON_SOURCE_GITHUB_APP_INSTALLATION_ID=
YAGAPON_SOURCE_GITHUB_APP_INSTALLATION_ID_FILE=
YAGAPON_SOURCE_GITHUB_APP_PRIVATE_KEY=
# Compose fixes the container path below; the host file stays outside /data.
YAGAPON_SOURCE_GITHUB_APP_PRIVATE_KEY_HOST_FILE=
YAGAPON_SOURCE_GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app-private-key.pem
# Compatibility fallback only; prefer the read-only GitHub App above.
YAGAPON_SOURCE_GITHUB_TOKEN=
YAGAPON_SOURCE_GITHUB_TOKEN_FILE=
# Production keeps the full-manifest guard enabled and leaves the repository
# filter empty. Set the guard false only for an intentional local subset.
YAGAPON_SOURCE_REQUIRE_FULL_MANIFEST=true
# Empty means every reviewed entry in source_index/repositories.yaml, never
# every repository visible to the organization-wide GitHub App installation.
YAGAPON_SOURCE_REPOSITORIES=
YAGAPON_SOURCE_HISTORY_SINCE=2024-10-01T00:00:00+09:00
YAGAPON_SOURCE_HISTORY_UNTIL=
YAGAPON_SOURCE_HISTORY_COMMITS_PER_CYCLE=100
YAGAPON_SOURCE_HISTORY_MAX_COMMITS=2000
YAGAPON_SOURCE_HISTORY_MAX_PAGES=20
YAGAPON_SOURCE_HISTORY_MAX_FILES_PER_COMMIT=300
YAGAPON_SOURCE_HISTORY_MAX_BYTES_PER_REPOSITORY=20000000
YAGAPON_SOURCE_HISTORY_MIN_RATE_REMAINING=200
YAGAPON_SOURCE_HISTORY_MAX_FILE_SNAPSHOTS_PER_REPOSITORY=10
