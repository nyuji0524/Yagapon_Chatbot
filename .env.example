GOOGLE_API_KEY=
YAGAPON_RAG_MODEL=gemini-3.8-flash
YAGAPON_RESPONSE_MODEL=gemini-3.8-flash
YAGAPON_FAST_MODEL=gemini-3.1-flash-lite
YAGAPON_TRANSCRIBE_MODEL=gemini-3.5-transcribe
YAGAPON_TRANSCRIBE_FALLBACK_MODEL=gemini-3.8-flash
YAGAPON_AUDIO_MODEL=gemini-3.8-flash
YAGAPON_DAILY_QUERY_LIMIT=400
YAGAPON_RAG_DB_PATH=/data/rag.sqlite3
YAGAPON_KEY_DB_PATH=/data/key-management.sqlite3
YAGAPON_KEY_REMINDER_HOURS=8
YAGAPON_KEY_REMINDER_REPEAT_HOURS=12
YAGAPON_KEY_NOTIFICATION_TTL_SECONDS=300
YAGAPON_RAG_TRACE_CONTENT=false
# Full backfill後にtrueへ切り替える（旧文書にはfestivalメタデータがないため）
YAGAPON_RAG_FESTIVAL_FILTER_ENABLED=false
DISCORD_TOKEN=
YAGAPON_API_TOKEN=
API_HOST=https://your-server.example.com
API_PORT=8000
GOOGLE_SERVICE_ACCOUNT_JSON=
# OAuth authorized-user JSONの本文またはコンテナ内パス。設定時はサービスアカウント/ADCより優先。
GOOGLE_OAUTH_AUTHORIZED_USER_JSON=
YAGAPON_CONFIG_PATH=/data/server_config.json
YAGAPON_CATALOG_PATH=/data/knowledge-catalog.json
YAGAPON_CATALOG_MODEL=gemini-3.1-flash-lite
YAGAPON_CATALOG_PASSES=2
YAGAPON_VOICEPRINT_DIR=/data/voiceprints
YAGAPON_RECORDING_DIR=/data/recordings
YAGAPON_TRANSCRIPT_DIR=/data/transcripts
YAGAPON_OPERATIONS_DB_PATH=/data/operations.sqlite3
YAGAPON_RECORDING_RECOVERY_BATCH_SIZE=3
YAGAPON_RECORDING_RECOVERY_MAX_ATTEMPTS=8
YAGAPON_RECORDING_RECOVERY_INTERVAL_SECONDS=300
YAGAPON_KNOWLEDGE_OUTBOX=/data/knowledge-outbox
YAGAPON_KNOWLEDGE_REPOSITORY=YagamiFes-IT/YagamiFes-IT-Knowledge
YAGAPON_KNOWLEDGE_BASE_BRANCH=main
# Fine-grained PAT: 対象KnowledgeリポジトリのContents/Pull requestsをRead and write。
YAGAPON_KNOWLEDGE_GITHUB_TOKEN=
# trueの場合のみ、要約に加えて詳細なAI議事録もDraft PRへ含める。
YAGAPON_KNOWLEDGE_INCLUDE_MINUTES=false
# 録音1セッションの上限(4 GiB)。さらにディスク空き容量から下記予備分を除いた範囲に自動制限される。
YAGAPON_MAX_RECORDING_BYTES=4294967296
YAGAPON_RECORDING_FREE_SPACE_RESERVE_BYTES=2147483648
# 音声は正常配信後に即時削除。ここでは配信メタデータの保持日数を指定する。
# 失敗・不完全な録音は文字起こし復旧用に自動削除しない。
YAGAPON_RECORDING_RETENTION_DAYS=7
GOOGLE_DRIVE_ID=
GOOGLE_DRIVE_FOLDER_ID=
YAGAPON_DRIVE_SYNC_STATE=/data/drive-sync-state.json
YAGAPON_DRIVE_RECURSIVE=true
YAGAPON_KNOWLEDGE_OUTPUT=/data/knowledge-drafts
YAGAPON_KNOWLEDGE_MODEL=gemini-3.8-flash
YAGAPON_KNOWLEDGE_REPO_PATH=../YagamiFes-IT-Knowledge
YAGAPON_KNOWLEDGE_BASE_URL=https://github.com/YagamiFes-IT/YagamiFes-IT-Knowledge/blob/main
YAGAPON_KNOWLEDGE_GUILD_ID=
YAGAPON_KNOWLEDGE_INDEX_STATE=/data/knowledge-index-state.json
YAGAPON_KNOWLEDGE_INDEX_STATUSES=active,historical,approved,verified,current
